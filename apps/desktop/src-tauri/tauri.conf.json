{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LifeMentor",
  "version": "0.1.1",
  "identifier": "ai.lifementor.app",
  "build": {
    "beforeDevCommand": "npm run dev --workspace @lifementor/web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --workspace @lifementor/web",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LifeMentor — личный ИИ-наставник",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}

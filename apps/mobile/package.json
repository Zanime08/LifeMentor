{
  "name": "@lifementor/mobile",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "LifeMentor Android shell (Capacitor 8). Packages the shared @lifementor/web bundle; native SQLite via @capacitor-community/sqlite.",
  "scripts": {
    "build:web": "npm run build --workspace @lifementor/web",
    "sync": "cap sync android",
    "android": "npm run build:web && cap sync android",
    "apk": "cd android && gradlew.bat assembleDebug",
    "apk:linux": "cd android && ./gradlew assembleDebug",
    "open": "cap open android"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/share": "^8.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1"
  }
}

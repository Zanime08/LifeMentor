# ─────────────────────────────────────────────────────────────────────────────
# LifeMentor server configuration
#
# Copy to `.env` and fill in. Everything here is OPERATOR-side: the desktop and
# Android clients never see these values — they only know the public server URL
# (req. 20, 58: provider keys live on the server, never on a device).
# ─────────────────────────────────────────────────────────────────────────────

# ── runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=8787
LOG_LEVEL=info

# Server database (accounts, sessions, devices, sync feed, AI usage, audit log).
# This is NOT the user's data store — that stays on each device.
DATABASE_PATH=data/server.sqlite
DATABASE_IN_MEMORY=false

# ── security ───────────────────────────────────────────────────────────────
# REQUIRED in production: at least 16 characters. Without it the server refuses
# to start (in development a throwaway secret is generated and logged as a warning).
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated allow-list of browser origins (the web dev preview by default).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BODY_LIMIT_BYTES=2097152

# ── rate limits (per IP + per token, per window) ───────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH=10
RATE_LIMIT_SYNC=120
RATE_LIMIT_AI=30
RATE_LIMIT_GENERAL=300

# ── AI providers (optional; at least one enables cloud AI) ─────────────────
# With no keys the gateway serves the built-in offline heuristic provider, so
# the product still works — degraded, and it says so.
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
GOOGLE_API_KEY=
GOOGLE_BASE_URL=

# Model overrides per tier (defaults live in packages/core/src/ai/providers/http.ts)
AI_MODEL_CHEAP=
AI_MODEL_MID=
AI_MODEL_STRONG=

# Per-user daily token budget and maximum request size, in characters.
AI_DAILY_TOKEN_BUDGET=400000
AI_MAX_INPUT_CHARS=200000

# ── Web Push (docs/08 §5) ──────────────────────────────────────────────────
# VAPID key pair for browser push. REQUIRED in production; in development a
# throwaway pair is generated per run (subscriptions then don't survive a restart).
# Generate a stable pair with:  npm run vapid:keys --workspace @lifementor/server
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A real email or https URL (used in the push payload's VAPID signature).
VAPID_SUBJECT=mailto:dev@lifementor.local
# Hard per-user daily cap for important-news pushes (anti-spam, req. 86).
NEWS_PUSH_DAILY_CAP=3

# ── FCM / Android push (docs/08 §5, docs/11 §8) ─────────────────────────────
# Optional. When unset, the FCM transport is OFF and Android `fcm` subscriptions are
# still delivered by the polling fallback (the client is honest about this). To enable:
# either point FIREBASE_SERVICE_ACCOUNT_FILE at the service-account JSON downloaded from the
# Firebase console (IAM & admin → Service accounts → Firebase AdminSDK), OR set all three:
FIREBASE_SERVICE_ACCOUNT_FILE=
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=fcm-admin@your-firebase-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
